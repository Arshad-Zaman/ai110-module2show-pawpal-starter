    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
    }

    class Pet {
        +str name
        +str species
        +str breed
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
    }

    class Task {
        +str name
        +str category
        +int duration_minutes
        +str priority
        +str recurrence
        +time scheduled_time
        +bool is_recurring() bool
        +conflicts_with(other) bool
    }

    class Scheduler {
        +int available_minutes
        +generate_plan(pet, available_minutes) list~Task~
        +sort_by_priority(tasks) list~Task~
        +filter_by_time(tasks, available_minutes) list~Task~
        +explain_plan(plan) str
    }

    Owner "1" --> "many" Pet : owns
    Pet "1" --> "many" Task : has
    Scheduler ..> Task : schedules
